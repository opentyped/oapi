{
  "name": "@opentyped/tsgen",
  "version": "0.1.0",
  "description": "Generate TypeScript definitions from OpenAPI documents",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "postbuild": "node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/cli.js', 0o755)\""
  },
  "dependencies": {
    "typescript": "~5.9.3",
    "@opentyped/openapi": "0.1.0"
  },
  "bin": {
    "oapi-tsgen": "./dist/cli.js"
  },
  "devDependencies": {
    "tsc-alias": "1.9.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opentyped/oapi.git",
    "directory": "packages/tsgen"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}

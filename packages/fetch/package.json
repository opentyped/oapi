{
  "name": "@opentyped/fetch",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed Fetch requests driven by OpenTyped OAPI route declarations",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "tsc-alias": "1.9.8"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opentyped/oapi.git",
    "directory": "packages/fetch"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}

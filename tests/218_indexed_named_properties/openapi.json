{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Model": {
        "type": "object",
        "properties": {
          "special": {
            "type": "object",
            "properties": {
              "name": {
                "allOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string",
                    "minLength": 3
                  }
                ]
              },
              "count": {
                "type": "number"
              },
              "children": {
                "$ref": "#/components/schemas/Model"
              }
            },
            "required": ["name", "count"],
            "additionalProperties": false
          }
        },
        "required": ["special"],
        "additionalProperties": {
          "$ref": "#/components/schemas/Value"
        }
      },
      "Value": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3
          },
          "children": {
            "$ref": "#/components/schemas/Model"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  }
}

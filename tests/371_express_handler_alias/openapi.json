{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": { "title": "Golden fixtures", "version": "1.0.0" },
  "paths": {
    "/events/{id}": {
      "get": {
        "operationId": "readEvent",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["json", "text"] }
          }
        ],
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/EventPayload" } },
              "text/plain": { "schema": { "type": "string" } }
            }
          },
          "404": { "description": "HTTP 404" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventPayload": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "previous": { "$ref": "#/components/schemas/EventPayload" }
        },
        "additionalProperties": false,
        "required": ["id"]
      }
    }
  }
}

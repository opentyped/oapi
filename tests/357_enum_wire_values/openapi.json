{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Dataset": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "selected": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Model"
              },
              {
                "type": "number"
              }
            ]
          },
          "counts": {
            "type": "object",
            "properties": {
              "ready-to-ship": {
                "type": "number"
              },
              "completed": {
                "type": "number"
              }
            },
            "required": ["ready-to-ship", "completed"],
            "additionalProperties": false
          }
        },
        "required": ["status", "selected", "counts"],
        "additionalProperties": false
      },
      "Status": {
        "type": "string",
        "enum": ["ready-to-ship", "completed"]
      },
      "Model": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          }
        },
        "required": ["name", "children"],
        "additionalProperties": false
      }
    }
  }
}

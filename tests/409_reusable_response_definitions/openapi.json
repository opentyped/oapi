{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {
    "/items/{id}": {
      "get": {
        "operationId": "readItem",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ItemResponse"
          },
          "404": {
            "$ref": "#/components/responses/ProblemResponse",
            "description": "The item was not found."
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ItemPayload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "ProblemPayload": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"],
        "additionalProperties": false
      }
    },
    "responses": {
      "ItemResponse": {
        "description": "An item was returned.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ItemPayload"
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "ProblemResponse": {
        "description": "A problem response.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemPayload"
            }
          }
        }
      }
    }
  }
}

{
  "securitySchemes": {
    "bearer": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT"
    },
    "apiKey": {
      "type": "apiKey",
      "in": "header",
      "name": "X-API-Key"
    },
    "oauth": {
      "type": "oauth2",
      "flows": {
        "clientCredentials": {
          "tokenUrl": "https://identity.example/token",
          "scopes": {
            "users:read": "Read users",
            "users:write": "Write users"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}

{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Model": {
        "type": "object",
        "properties": {
          "kind": {
            "allOf": [
              {
                "type": "string",
                "const": "dictionary"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": ["kind"],
        "additionalProperties": {
          "type": "string"
        },
        "propertyNames": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "string",
              "pattern": "^item-[\\s\\S]*(?![\\s\\S])",
              "minLength": 8
            }
          ]
        }
      }
    }
  }
}

{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {
    "/search": {
      "get": {
        "operationId": "Search",
        "parameters": [
          {
            "name": "color",
            "in": "query",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "red": {
                  "type": "number"
                },
                "green": {
                  "type": "number"
                }
              },
              "required": ["red", "green"],
              "additionalProperties": false
            },
            "style": "spaceDelimited",
            "explode": false
          },
          {
            "name": "labels",
            "in": "query",
            "required": false,
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "style": "pipeDelimited"
          }
        ],
        "responses": {
          "204": {
            "description": "HTTP 204"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}

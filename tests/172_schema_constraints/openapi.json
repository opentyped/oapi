{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": { "title": "Golden fixtures", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "Model": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "readOnly": true },
          "price": { "type": "number", "multipleOf": 0.5, "minimum": 0, "exclusiveMaximum": 100 },
          "secret": { "type": "string", "writeOnly": true, "minLength": 3, "maxLength": 20 },
          "payload": {
            "type": "string",
            "contentEncoding": "base64",
            "contentMediaType": "application/json"
          },
          "labels": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 3
          }
        },
        "required": ["id", "price"],
        "additionalProperties": false,
        "minProperties": 2,
        "maxProperties": 5
      }
    }
  }
}

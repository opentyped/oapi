              "displayName": { "type": "string", "xml": { "name": "display_name" } },
              "labels": {
                "type": "array",
                "items": { "type": "string" },
                "xml": { "name": "labels", "wrapped": true }
              },
              "manager": { "$ref": "#/components/schemas/XmlUser", "xml": { "name": "manager" } }
            },
            "required": ["id", "displayName", "labels"],

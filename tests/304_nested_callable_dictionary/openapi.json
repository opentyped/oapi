{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {
    "/nested": {
      "post": {
        "operationId": "nestedDictionaryEndpoint",
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Output"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "values": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false,
                    "patternProperties": {
                      "^item_[\\s\\S]*(?![\\s\\S])": {
                        "$ref": "#/components/schemas/Output"
                      }
                    }
                  }
                },
                "required": ["values"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Output": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Output"
            }
          }
        },
        "required": ["label"],
        "additionalProperties": false
      }
    }
  }
}

{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": { "title": "Golden fixtures", "version": "1.0.0" },
  "paths": {},
  "components": {
    "schemas": {
      "models.Price": { "type": "string" },
      "models.Tree": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "const": "leaf" },
              "price": { "type": "string" }
            },
            "required": ["kind", "price"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "const": "branch" },
              "children": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/models.Tree" }
              }
            },
            "required": ["kind", "children"]
          }
        ]
      }
    }
  }
}

{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": { "title": "Golden fixtures", "version": "1.0.0" },
  "paths": {
    "/encoded": {
      "get": {
        "operationId": "encoded",
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/x-www-form-urlencoded": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "label": { "type": "string" },
                    "tag": { "type": "array", "items": { "type": "string" } }
                  },
                  "required": ["label", "tag"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/multipart": {
      "get": {
        "operationId": "multipart",
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "multipart/form-data": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "label": { "type": "string" },
                    "file": { "type": "string", "format": "binary" }
                  },
                  "required": ["label", "file"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": { "schemas": {} }
}

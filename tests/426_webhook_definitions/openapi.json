{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "UserPayload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    }
  },
  "webhooks": {
    "user/created": {
      "post": {
        "operationId": "UserCreated",
        "responses": {
          "204": {
            "description": "HTTP 204"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserPayload"
              }
            }
          }
        }
      }
    },
    "user/deleted": {
      "post": {
        "operationId": "UserDeleted",
        "responses": {
          "204": {
            "description": "HTTP 204"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": ["id"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}

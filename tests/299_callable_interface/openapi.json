{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": { "title": "Golden fixtures", "version": "1.0.0" },
  "paths": {
    "/interface": {
      "post": {
        "operationId": "interfaceEndpoint",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Input" } } }
        },
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Output" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Input": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 2 },
          "next": { "$ref": "#/components/schemas/Input" }
        },
        "required": ["code"],
        "additionalProperties": false
      },
      "Output": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "children": { "type": "array", "items": { "$ref": "#/components/schemas/Output" } }
        },
        "required": ["label"],
        "additionalProperties": false
      }
    }
  }
}

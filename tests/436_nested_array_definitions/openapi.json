{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Line"
            }
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "totals": {
            "type": "object",
            "properties": {
              "sub": {
                "type": "number"
              },
              "tax": {
                "type": "number"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["sub", "tags"],
            "additionalProperties": false
          }
        },
        "required": ["id", "lines", "totals"],
        "additionalProperties": false
      },
      "Line": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        },
        "required": ["sku", "quantity"],
        "additionalProperties": false
      }
    }
  }
}

{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "operationId": "read",
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Model": {
        "$ref": "#/components/schemas/BoxOfUser"
      },
      "BoxOfUser": {
        "type": "object",
        "properties": {
          "value": {
            "$ref": "#/components/schemas/User"
          },
          "next": {
            "$ref": "#/components/schemas/BoxOfUser"
          }
        },
        "required": ["value"],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "manager": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  }
}

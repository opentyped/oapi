          "manager": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "Rejected": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "const": "rejected"
          }
        },
        "required": ["code"],
        "additionalProperties": false
      },
      "Either": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/Selected"
          },
          {
            "$ref": "#/components/schemas/Rejected"
          }
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "manager": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  }
}

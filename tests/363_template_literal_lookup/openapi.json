          "general": {
            "$ref": "#/components/schemas/Base"
          },
          "special": {
            "type": "object",
            "properties": {
              "name": {
                "allOf": [
                  {
                    "type": "string",
                    "minLength": 2
                  },
                  {
                    "type": "string",
                    "minLength": 2
                  }
                ]
              },
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Base"
                }
              },
              "rank": {
                "type": "number"
              }
            },
            "required": ["name", "children", "rank"],
            "additionalProperties": false
          }
        },
        "required": ["general", "special"],
        "additionalProperties": false
      },
      "Base": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Base"
            }
          }
        },
        "required": ["name", "children"],
        "additionalProperties": false

{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Results": {
        "type": "object",
        "properties": {
          "fixed": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "#/components/schemas/User",
                "title": "user"
              },
              {
                "$ref": "#/components/schemas/Missing",
                "title": "missing"
              }
            ],
            "items": false,
            "minItems": 1,
            "maxItems": 2
          },
          "rest": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "#/components/schemas/User"
              }
            ],
            "items": {
              "$ref": "#/components/schemas/Missing"
            },
            "minItems": 1
          }
        },
        "required": ["fixed", "rest"],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "manager": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "Missing": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "const": "missing"
          }
        },
        "required": ["error"],
        "additionalProperties": false
      }
    }
  }
}

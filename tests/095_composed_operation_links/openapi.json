{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {
    "/v1~beta/items": {
      "post": {
        "operationId": "nested_createItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  }
                },
                "required": ["title"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/CreatedResponse"
          }
        }
      }
    },
    "/v1~beta/items/{id}": {
      "get": {
        "operationId": "nested_readItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    },
    "responses": {
      "CreatedResponse": {
        "description": "Item created",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Item"
            }
          }
        },
        "links": {
          "ReadById": {
            "operationId": "nested_readItem",
            "parameters": {
              "id": "$response.body#/id"
            },
            "description": "Read the new item"
          },
          "ReadByRef": {
            "operationRef": "#/paths/~1v1~0beta~1items~1%7Bid%7D/get",
            "parameters": {
              "id": "$response.body#/id"
            }
          },
          "CreateAgain": {
            "operationId": "nested_createItem",
            "requestBody": {
              "operationId": "createItem",
              "operationRef": "#/paths/~1items~1%7Bid%7D/get"
            },
            "x-purpose": "retry"
          }
        },
        "x-copy": {
          "operationId": "createItem",
          "operationRef": "#/paths/~1items~1%7Bid%7D/get"
        }
      }
    }
  }
}

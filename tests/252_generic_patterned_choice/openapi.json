{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Model": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "fallback": {
                "type": "boolean",
                "const": true
              }
            },
            "required": ["fallback"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "dictionary"
              }
            },
            "required": ["kind"],
            "additionalProperties": false,
            "patternProperties": {
              "^item-[\\s\\S]*(?![\\s\\S])": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}

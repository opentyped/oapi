{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Model": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Extra"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": ["meta", "enabled"],
        "additionalProperties": false,
        "patternProperties": {
          "^item-[\\s\\S]*(?![\\s\\S])": {
            "$ref": "#/components/schemas/Value"
          }
        }
      },
      "Extra": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          },
          "label": {
            "type": "string",
            "minLength": 2
          }
        },
        "required": ["count", "label"],
        "additionalProperties": false
      },
      "Value": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  }
}

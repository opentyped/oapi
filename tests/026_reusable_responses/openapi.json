{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {
    "/items/{id}": {
      "get": {
        "operationId": "readItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ItemResponse"
          },
          "404": {
            "$ref": "#/components/responses/ProblemResponse",
            "description": "The item was not found."
          }
        }
      }
    },
    "/items": {
      "post": {
        "operationId": "createItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/ItemResponse"
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                }
              }
            }
          },
          "4XX": {
            "description": "A problem response.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemPayload"
                },
                "example": {
                  "message": "Request rejected"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ItemPayload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "parent": {
            "$ref": "#/components/schemas/ItemPayload"
          }
        },
        "additionalProperties": false,
        "required": ["id"]
      },
      "ProblemPayload": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": ["message"]
      },
      "CreateBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": ["title"]
      }
    },
    "responses": {
      "ItemResponse": {
        "description": "An item was returned.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ItemPayload"
            }
          }
        },
        "headers": {
          "X-Request-Id": {
            "schema": {
              "type": "string"
            },
            "required": true
          }
        }
      },
      "ProblemResponse": {
        "description": "A problem response.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemPayload"
            }
          }
        }
      }
    }
  }
}

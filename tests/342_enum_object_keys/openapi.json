{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Dataset": {
        "type": "object",
        "properties": {
          "selected": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 2
              },
              {
                "$ref": "#/components/schemas/test.Model.children"
              }
            ]
          },
          "numeric": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Model"
              },
              {
                "type": "number"
              }
            ]
          },
          "numericLiteral": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Model"
              },
              {
                "type": "number"
              }
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 2
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "required": ["selected", "numeric"],
        "additionalProperties": false
      },
      "test.Model.children": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Model"
        }
      },
      "Model": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "children": {
            "$ref": "#/components/schemas/test.Model.children"
          }
        },
        "required": ["name", "children"],
        "additionalProperties": false
      }
    }
  }
}

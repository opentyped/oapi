{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {
    "/tagged": {
      "post": {
        "operationId": "taggedDictionaryEndpoint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "values": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "items"
                          }
                        },
                        "required": ["kind"],
                        "additionalProperties": false,
                        "patternProperties": {
                          "^item_[\\s\\S]*(?![\\s\\S])": {
                            "$ref": "#/components/schemas/Output"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "extras"
                          }
                        },
                        "required": ["kind"],
                        "additionalProperties": false,
                        "patternProperties": {
                          "^extra_[\\s\\S]*(?![\\s\\S])": {
                            "$ref": "#/components/schemas/Output"
                          }
                        }
                      }
                    ]
                  }
                },
                "required": ["values"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Output"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Output": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Output"
            }
          }
        },
        "required": ["label"],
        "additionalProperties": false
      }
    }
  }
}

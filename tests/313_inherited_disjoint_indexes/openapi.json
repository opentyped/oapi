{
  "openapi": "3.2.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Golden fixtures",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Model": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          }
        },
        "required": ["version"],
        "additionalProperties": false,
        "patternProperties": {
          "^user_[\\s\\S]*(?![\\s\\S])": {
            "$ref": "#/components/schemas/User"
          },
          "^count_[\\s\\S]*(?![\\s\\S])": {
            "type": "number"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "children": {
            "$ref": "#/components/schemas/Model"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  }
}
